<Window x:Class="ZharikovApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ZharikovApp.ViewModels"
        Title="{Binding Title}"
        Height="600" Width="900"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="ZharikovApp"
                       FontSize="32" FontWeight="Bold"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Каркас проекта. Источник методик: docs/methodics_source.md (12 блоков)."
                       FontSize="14" Margin="0,12,0,0"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Логика методик будет реализована следующим этапом."
                       FontSize="14" Foreground="Gray" Margin="0,4,0,0"
                       HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>
