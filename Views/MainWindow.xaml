<Window x:Class="ZharikovApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ZharikovApp.ViewModels"
        Title="{Binding Title}"
        Height="780" Width="1240" MinHeight="600" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Ideal"
        FontFamily="Segoe UI"
        TextElement.Foreground="#EDEFFA"
        TextElement.FontSize="15">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0B0E24" Offset="0"/>
            <GradientStop Color="#141A44" Offset="0.55"/>
            <GradientStop Color="#221545" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <SolidColorBrush x:Key="Surface" Color="#171C46"/>
        <SolidColorBrush x:Key="Line" Color="#2E3676"/>
        <SolidColorBrush x:Key="Ink" Color="#EDEFFA"/>
        <SolidColorBrush x:Key="Muted" Color="#A7AED6"/>
        <SolidColorBrush x:Key="Cyan" Color="#22D3EE"/>
        <SolidColorBrush x:Key="Amber" Color="#F5A524"/>
        <SolidColorBrush x:Key="Success" Color="#2FBF71"/>

        <LinearGradientBrush x:Key="AccentFlow" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#3D6BFF" Offset="0"/>
            <GradientStop Color="#22D3EE" Offset="0.5"/>
            <GradientStop Color="#E8467C" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="HeaderFlow" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#101540" Offset="0"/>
            <GradientStop Color="#1B2160" Offset="0.5"/>
            <GradientStop Color="#2B1A55" Offset="1"/>
        </LinearGradientBrush>

        <!-- Только перенос. Цвет и размер наследуются от окна и кнопок. -->
        <Style TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="Foreground" Value="#EDEFFA"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="#171C46" BorderBrush="#3D6BFF" BorderThickness="1"
                                CornerRadius="10" Padding="12,8">
                            <TextBlock Text="{TemplateBinding Content}" FontSize="14"
                                       Foreground="#EDEFFA" TextWrapping="Wrap" MaxWidth="320"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <Border Background="#10143A" CornerRadius="6" Margin="2,0"/>
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="T" Background="#3D6BFF" CornerRadius="6" Margin="2,1"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="T" Property="Background" Value="#22D3EE"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="T" Property="Background" Value="#E8467C"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" Background="#0D1132" CornerRadius="5"/>
                            <Border x:Name="PART_Indicator" CornerRadius="5" HorizontalAlignment="Left"
                                    Background="{StaticResource AccentFlow}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value><ScaleTransform/></Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" CornerRadius="12" Background="#232A63"
                                BorderBrush="#3A4490" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              TextElement.FontSize="{TemplateBinding FontSize}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#2C3579"/>
                                <Setter TargetName="B" Property="BorderBrush" Value="#22D3EE"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#1A2050"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="B" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.025" Duration="0:0:0.12"/>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.025" Duration="0:0:0.12"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.14"/>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.14"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" CornerRadius="12" Padding="{TemplateBinding Padding}"
                                Background="{StaticResource AccentFlow}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="White"
                                              TextElement.FontSize="{TemplateBinding FontSize}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="B" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OptionBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,6"/>
            <Setter Property="MinHeight" Value="58"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" CornerRadius="14" Padding="16,12"
                                Background="#1B2150" BorderBrush="#333C82" BorderThickness="1">
                            <ContentPresenter VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#232B65"/>
                                <Setter TargetName="B" Property="BorderBrush" Value="#22D3EE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border CornerRadius="14" Padding="16,12"
                                        Background="#2A3690" BorderBrush="#22D3EE" BorderThickness="2">
                                    <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="White"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ScaleBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="58"/>
            <Setter Property="Height" Value="58"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" CornerRadius="14" Background="#1B2150"
                                BorderBrush="#333C82" BorderThickness="1">
                            <TextBlock Text="{TemplateBinding Content}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontWeight="{TemplateBinding FontWeight}"
                                       Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="BorderBrush" Value="#22D3EE"/>
                                <Setter TargetName="B" Property="Background" Value="#26306E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border CornerRadius="14" Background="{StaticResource AccentFlow}">
                                    <TextBlock Text="{TemplateBinding Content}" FontSize="22" FontWeight="Bold"
                                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="26"/>
        </Style>

        <Style x:Key="SavedCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFinalReport}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ReportCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFinalReport}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PlaceholderCard" TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="BorderBrush" Value="#3D6BFF"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Background" Value="#0A0D26"/>
            <Setter Property="MinHeight" Value="190"/>
            <Setter Property="Padding" Value="24"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ShowImagePlaceholder}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BlockCard" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="10,5"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="B" CornerRadius="14" Padding="14,12"
                                Background="#161B45" BorderBrush="#2A3170" BorderThickness="1">
                            <ContentPresenter TextElement.Foreground="{StaticResource Ink}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#1E2559"/>
                                <Setter TargetName="B" Property="BorderBrush" Value="#22D3EE"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#26307A"/>
                                <Setter TargetName="B" Property="BorderBrush" Value="#3D6BFF"/>
                                <Setter TargetName="B" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabChip" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="B" CornerRadius="11" Padding="16,8"
                                Background="#1A2050" BorderBrush="#333C82" BorderThickness="1">
                            <ContentPresenter TextElement.Foreground="{StaticResource Ink}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#2E3A8C"/>
                                <Setter TargetName="B" Property="BorderBrush" Value="#22D3EE"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="BorderBrush" Value="#E8467C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource HeaderFlow}" Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding Title}" FontSize="23" FontWeight="Bold" Foreground="{StaticResource Ink}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <ListBox ItemsSource="{Binding Packs}" SelectedItem="{Binding SelectedPack, Mode=TwoWay}"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource TabChip}"/>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Header}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="#EDEFFA"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="{Binding CurrentBlockTitle}" FontSize="14" Foreground="{StaticResource Muted}"
                                   VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <Grid>
                        <TextBlock Text="{Binding OverallProgressText}" FontSize="13" Foreground="{StaticResource Muted}"/>
                        <TextBlock Text="{Binding ProgressShort}" FontSize="19" FontWeight="Bold"
                                   HorizontalAlignment="Right" Foreground="{StaticResource Cyan}"/>
                    </Grid>
                    <ProgressBar Value="{Binding OverallProgressPercent}" Minimum="0" Maximum="100" Margin="0,8,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#0F1338" BorderBrush="#242B66" BorderThickness="0,0,1,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="МЕТОДИКИ" FontSize="12" FontWeight="Bold"
                               Foreground="{StaticResource Muted}" Margin="20,18,20,8"/>
                    <ListBox ItemsSource="{Binding Blocks}" SelectedItem="{Binding SelectedBlock, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource BlockCard}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding DisplayTitle}" FontSize="15"
                                               TextWrapping="Wrap" Foreground="#EDEFFA" VerticalAlignment="Center"/>
                                    <Border Grid.Column="1" CornerRadius="9" Padding="9,4" Margin="10,0,0,0"
                                            Background="#0C1030" BorderBrush="#333C82" BorderThickness="1"
                                            VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding StatusGlyph}" FontSize="13"
                                                       Foreground="#22D3EE" Margin="0,0,5,0"/>
                                            <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="#A7AED6"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1" Margin="28,24">

                <Border Style="{StaticResource Card}" MaxWidth="640"
                        VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding IsWelcomeVisible, Converter={StaticResource BoolToVis}}">
                    <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
                    <Border.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.35"/>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                     From="22" To="0" Duration="0:0:0.45">
                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Border.Triggers>
                    <StackPanel>
                        <Border Height="5" CornerRadius="3" Background="{StaticResource AccentFlow}" Margin="0,0,0,20"/>
                        <TextBlock Text="Двенадцать методик диагностики" FontSize="27" FontWeight="Bold" Foreground="{StaticResource Ink}"/>
                        <TextBlock Margin="0,12,0,0" Foreground="{StaticResource Muted}" FontSize="16" LineHeight="25"
                                   Text="Выберите методику слева. Ответы сохраняются автоматически, промежуточные баллы скрыты — подробный разбор откроется в итоговом отчёте после всех двенадцати."/>
                        <Button Style="{StaticResource PrimaryBtn}" Margin="0,22,0,0" HorizontalAlignment="Left"
                                Content="Начать с первой методики" Command="{Binding GoNextBlockCommand}"/>
                    </StackPanel>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding IsInstructionVisible, Converter={StaticResource BoolToVis}}">
                    <Border Style="{StaticResource Card}">
                        <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
                        <Border.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3"/>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                         From="18" To="0" Duration="0:0:0.4">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Border.Triggers>
                        <StackPanel>
                            <TextBlock Text="{Binding CurrentBlockTitle}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource Ink}"/>
                            <Border Height="4" CornerRadius="2" Background="{StaticResource AccentFlow}" Margin="0,14,0,18"/>
                            <TextBlock Text="ИНСТРУКЦИЯ" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Amber}"/>
                            <TextBlock Text="{Binding BlockInstruction}" Margin="0,10,0,0" FontSize="17" LineHeight="28"
                                       Foreground="{StaticResource Ink}"/>
                            <Button Style="{StaticResource PrimaryBtn}" Margin="0,24,0,0" HorizontalAlignment="Left"
                                    Content="Перейти к вопросам" Command="{Binding GoNextCommand}"/>
                        </StackPanel>
                    </Border>
                </ScrollViewer>

                <Grid Visibility="{Binding IsQuestionsVisible, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,14">
                        <Grid>
                            <TextBlock FontSize="13" Foreground="{StaticResource Muted}">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="Вопрос {0} из {1}">
                                        <Binding Path="CurrentQuestionIndex"/>
                                        <Binding Path="TotalQuestions"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                            <TextBlock HorizontalAlignment="Right" FontSize="12" Foreground="#8B94C6"
                                       Text="цифры — ответ · стрелки — выбор · Enter — далее · Ctrl+Enter — завершить"/>
                        </Grid>
                        <ProgressBar Margin="0,8,0,0" Height="6" Minimum="0"
                                     Value="{Binding CurrentQuestionIndex}" Maximum="{Binding TotalQuestions}"/>
                    </StackPanel>

                    <ContentControl Grid.Row="1" Content="{Binding CurrentQuestion}"
                                    Foreground="{StaticResource Ink}"
                                    TextElement.Foreground="{StaticResource Ink}">
                        <ContentControl.ContentTemplate>
                            <DataTemplate>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <Border Style="{StaticResource Card}" Margin="0,0,4,0">
                                        <StackPanel TextElement.Foreground="#EDEFFA">
                                            <TextBlock FontSize="21" LineHeight="30" Margin="0,0,0,18" Foreground="#EDEFFA">
                                                <Run Text="{Binding Number, Mode=OneWay, StringFormat='{}{0}. '}"
                                                     Foreground="#22D3EE" FontWeight="Bold"/><Run Text="{Binding Text, Mode=OneWay}" Foreground="#EDEFFA"/>
                                            </TextBlock>

                                            <Grid Margin="0,0,0,18"
                                                  Visibility="{Binding HasImage, Converter={StaticResource BoolToVis}}">
                                                <Border CornerRadius="14" BorderBrush="#333C82" BorderThickness="1"
                                                        Background="#0A0D26" Padding="4">
                                                    <Image Source="{Binding ImagePicture}" MaxHeight="280" Stretch="Uniform"/>
                                                </Border>
                                                <Border Style="{StaticResource PlaceholderCard}">
                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                        <TextBlock Text="◧" FontSize="40" Foreground="#3D6BFF" HorizontalAlignment="Center"/>
                                                        <TextBlock Text="{Binding ImageCaption}" FontSize="17" FontWeight="SemiBold"
                                                                   Foreground="#EDEFFA" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                                                        <TextBlock FontSize="13" Foreground="#9AA2CE" Margin="0,8,0,0"
                                                                   HorizontalAlignment="Center" TextAlignment="Center"
                                                                   Text="Место для иллюстрации. Положите файл в Assets/Images рядом с программой."/>
                                                        <TextBlock Text="{Binding ImageFileName}" FontSize="13" Foreground="#F5A524"
                                                                   HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>

                                            <ItemsControl ItemsSource="{Binding Options}"
                                                          Foreground="#EDEFFA"
                                                          Visibility="{Binding IsChoice, Converter={StaticResource BoolToVis}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Style="{StaticResource OptionBtn}" Command="{Binding SelectCommand}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Border Width="34" Height="34" CornerRadius="10" Background="#0D1132"
                                                                        BorderBrush="#3D6BFF" BorderThickness="1" Margin="0,0,14,0">
                                                                    <TextBlock Text="{Binding Letter}" FontSize="17" FontWeight="Bold"
                                                                               Foreground="#22D3EE" HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center"/>
                                                                </Border>
                                                                <TextBlock Text="{Binding Text}" FontSize="17" Foreground="#EDEFFA"
                                                                           VerticalAlignment="Center" MaxWidth="620"/>
                                                            </StackPanel>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <StackPanel Visibility="{Binding IsScale, Converter={StaticResource BoolToVis}}">
                                                <Grid Margin="0,0,0,10">
                                                    <TextBlock HorizontalAlignment="Left" FontSize="13" Foreground="{StaticResource Muted}"
                                                               Text="{Binding ScaleMin, StringFormat='минимум {0}'}"/>
                                                    <TextBlock HorizontalAlignment="Right" FontSize="13" Foreground="{StaticResource Muted}"
                                                               Text="{Binding ScaleMax, StringFormat='максимум {0}'}"/>
                                                </Grid>
                                                <ItemsControl ItemsSource="{Binding ScaleChoices}" Foreground="#EDEFFA">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Style="{StaticResource ScaleBtn}"
                                                                    Content="{Binding Value}" Command="{Binding SelectCommand}"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                                    <TextBlock Text="Ваш ответ:" FontSize="15" Foreground="{StaticResource Muted}"
                                                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                    <TextBlock Text="{Binding ScaleAnswerText}" FontSize="24" FontWeight="Bold"
                                                               Foreground="{StaticResource Cyan}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </ScrollViewer>
                            </DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>
                </Grid>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding IsResultVisible, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Border Style="{StaticResource SavedCard}">
                            <StackPanel>
                                <Border Width="66" Height="66" CornerRadius="33" Background="#12331F"
                                        BorderBrush="{StaticResource Success}" BorderThickness="2" HorizontalAlignment="Left">
                                    <TextBlock Text="✓" FontSize="32" Foreground="{StaticResource Success}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Ответы сохранены" FontSize="26" FontWeight="Bold"
                                           Foreground="{StaticResource Ink}" Margin="0,18,0,0"/>
                                <TextBlock Text="{Binding SavedTitle}" FontSize="17" Foreground="{StaticResource Cyan}" Margin="0,6,0,0"/>
                                <TextBlock Text="{Binding SavedNote}" FontSize="16" Foreground="{StaticResource Muted}"
                                           LineHeight="25" Margin="0,14,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                                    <Button Style="{StaticResource PrimaryBtn}" Content="Следующая методика"
                                            Command="{Binding GoNextBlockCommand}"
                                            Visibility="{Binding HasNextBlock, Converter={StaticResource BoolToVis}}"/>
                                    <Button Style="{StaticResource Btn}" Content="Пройти этот блок заново"
                                            Command="{Binding RestartBlockCommand}" Margin="12,0,0,0"/>
                                </StackPanel>
                                <TextBlock Text="{Binding NextBlockTitle}" FontSize="14" Foreground="#8B94C6" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ReportCard}">
                            <StackPanel>
                                <TextBlock Text="Итоговый отчёт" FontSize="26" FontWeight="Bold" Foreground="{StaticResource Ink}"/>
                                <Border Height="4" CornerRadius="2" Background="{StaticResource AccentFlow}" Margin="0,14,0,18"/>
                                <TextBox Text="{Binding ReportText, Mode=OneWay}" IsReadOnly="True"
                                         FontFamily="Consolas" FontSize="14"
                                         Background="#0C1030" Foreground="#EDEFFA" CaretBrush="#22D3EE"
                                         SelectionBrush="#3D6BFF"
                                         BorderBrush="#333C82" BorderThickness="1" Padding="16"
                                         TextWrapping="Wrap" AcceptsReturn="True" MinHeight="360"
                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"/>
                                <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                                    <Button Style="{StaticResource PrimaryBtn}" Content="Сохранить в .txt"
                                            Command="{Binding ExportReportCommand}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="#0F1338" BorderBrush="#242B66" BorderThickness="0,1,0,0" Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Style="{StaticResource Btn}" Content="← Назад" Command="{Binding GoBackCommand}" MinWidth="120"/>
                    <Button Style="{StaticResource Btn}" Content="Далее →" Command="{Binding GoNextCommand}"
                            MinWidth="120" Margin="10,0,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="18,0">
                    <TextBlock Text="{Binding StatusMessage}" FontSize="14" Foreground="{StaticResource Muted}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding FinalReportGateText}" FontSize="12" Foreground="#8B94C6"
                               TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{StaticResource PrimaryBtn}" Content="Завершить блок"
                            Command="{Binding CompleteBlockCommand}" MinWidth="170"/>
                    <Button Style="{StaticResource Btn}" Content="Итоговый отчёт"
                            Command="{Binding OpenFinalReportCommand}" MinWidth="160" Margin="10,0,0,0"
                            ToolTip="{Binding FinalReportGateText}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
