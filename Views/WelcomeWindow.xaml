<Window x:Class="ZharikovApp.Views.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ZharikovApp.ViewModels"
        Title="Добро пожаловать"
        Height="640" Width="760"
        MinHeight="520" MinWidth="640"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        FontSize="16"
        Background="#F4F6FA">

    <Window.DataContext>
        <vm:WelcomeViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Крупная основная кнопка -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1E3A5F"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="26,12"/>
            <Setter Property="Margin" Value="8,0"/>
            <Setter Property="MinWidth" Value="220"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8" Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FFB74D"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Обычная кнопка -->
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#5B7EA6"/>
        </Style>

        <!-- Кнопка сброса (тревожный цвет) -->
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#8E3B46"/>
        </Style>
    </Window.Resources>

    <!-- Esc закрывает окно как «Отмена» -->
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}"/>
    </Window.InputBindings>

    <Grid Margin="28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Заголовок -->
            <RowDefinition Height="Auto"/>  <!-- Подзаголовок -->
            <RowDefinition Height="*"/>     <!-- Список аспектов -->
            <RowDefinition Height="Auto"/>  <!-- Примечание -->
            <RowDefinition Height="Auto"/>  <!-- Информация о сессии -->
            <RowDefinition Height="Auto"/>  <!-- Кнопки -->
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Психодиагностический комплекс"
                   FontSize="28" FontWeight="Bold" Foreground="#1E3A5F"/>

        <TextBlock Grid.Row="1" Margin="0,6,0,14"
                   Text="Самопознание по методикам Жарикова и Крушельницкого: 12 блоков, около 200 вопросов"
                   FontSize="16" Foreground="#4A5B70"/>

        <Border Grid.Row="2" Background="White" CornerRadius="10" Padding="20,14"
                BorderBrush="#D7DEE8" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Приложение исследует:" FontWeight="Bold" FontSize="17"
                               Foreground="#1E3A5F" Margin="0,0,0,8"/>
                    <TextBlock FontSize="16" LineHeight="26" Foreground="#2B3A4A" TextWrapping="Wrap">
                        • лидерские качества;<LineBreak/>
                        • стиль управления;<LineBreak/>
                        • коммуникативные особенности;<LineBreak/>
                        • тип мышления;<LineBreak/>
                        • экстраверсию и интроверсию;<LineBreak/>
                        • биологические маркеры;<LineBreak/>
                        • творческий потенциал;<LineBreak/>
                        • творческий возраст;<LineBreak/>
                        • особенности почерка и подписи;<LineBreak/>
                        • поведенческие реакции и предпочтения.
                    </TextBlock>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <TextBlock Grid.Row="3" Margin="0,14,0,6" TextWrapping="Wrap"
                   FontSize="14" Foreground="#7A5C00">
            Результаты носят ориентировочный и образовательный характер.
            Приложение не является медицинским или клиническим инструментом
            и не ставит диагнозов.
        </TextBlock>

        <!-- Появляется только при наличии сохранённой сессии -->
        <TextBlock Grid.Row="4" Margin="0,2,0,6" TextWrapping="Wrap"
                   FontSize="14" Foreground="#1E3A5F"
                   Visibility="{Binding HasSavedSession, Converter={StaticResource BoolToVis}}"
                   Text="{Binding SavedSessionInfo}"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center"
                    Margin="0,10,0,0">

            <!-- Основная кнопка: Enter активирует её (IsDefault) -->
            <Button Content="Начать тестирование"
                    Style="{StaticResource PrimaryButton}"
                    IsDefault="True"
                    Command="{Binding StartCommand}"/>

            <Button Content="Продолжить"
                    Style="{StaticResource SecondaryButton}"
                    Command="{Binding ContinueCommand}"
                    Visibility="{Binding HasSavedSession, Converter={StaticResource BoolToVis}}"/>

            <Button Content="Начать заново"
                    Style="{StaticResource DangerButton}"
                    Command="{Binding RestartCommand}"
                    Visibility="{Binding HasSavedSession, Converter={StaticResource BoolToVis}}"/>

            <Button Content="Отмена"
                    Style="{StaticResource SecondaryButton}"
                    IsCancel="True"
                    Command="{Binding CancelCommand}"/>
        </StackPanel>
    </Grid>
</Window>
