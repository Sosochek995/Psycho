<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>ZharikovApp</RootNamespace>
    <AssemblyName>ZharikovApp</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Иконка-заглушка; замените Assets/app_icon.ico на финальную — код менять не нужно -->
    <ApplicationIcon>Assets\app_icon.ico</ApplicationIcon>
    <!-- Позволяет выполнять restore/build кросс-платформенно (например, на CI под Linux).
         Запуск приложения по-прежнему возможен только на Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>

    <!-- Публикация: автономный single-file exe (win-x64), .NET на машине не требуется -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- WinExe: приложение оконное, консольное окно при запуске не показывается -->
  </PropertyGroup>

  <PropertyGroup>
    <!-- Не собирать резервные копии инструментов защиты (tools/baseline/backup, emergency_backup_*) -->
    <DefaultItemExcludes>$(DefaultItemExcludes);tools\**;tests\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Источник методик и данные блоков -->
    <None Include="docs\**" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Data\Blocks\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Изображения (фигуры Пальмера, образцы почерка/подписи) -->
    <Resource Include="Assets\Images\**\*.png" />
    <Resource Include="Assets\Images\**\*.jpg" />
  </ItemGroup>

</Project>
