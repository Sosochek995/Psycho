<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>ZharikovApp</RootNamespace>
    <AssemblyName>ZharikovApp</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Позволяет выполнять restore/build кросс-платформенно (например, на CI под Linux).
         Запуск приложения по-прежнему возможен только на Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Источник методик и данные блоков -->
    <None Include="docs\**" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Data\Blocks\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Изображения (фигуры Пальмера, образцы почерка/подписи) -->
    <Resource Include="Assets\Images\**\*.png" />
    <Resource Include="Assets\Images\**\*.jpg" />
  </ItemGroup>

</Project>
