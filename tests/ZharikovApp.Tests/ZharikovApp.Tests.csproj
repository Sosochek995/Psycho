<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- Подключаем исходники приложения (Models/Services) без зависимости от WPF-слоя -->
  <ItemGroup>
    <Compile Include="..\..\Models\**\*.cs" LinkBase="Linked\Models" />
    <Compile Include="..\..\Helpers\PathHelper.cs" Link="Linked\Helpers\PathHelper.cs" />
    <Compile Include="..\..\Services\ScoringService.cs" Link="Linked\Services\ScoringService.cs" />
    <Compile Include="..\..\Services\Interfaces\*.cs" LinkBase="Linked\Services\Interfaces" />
  </ItemGroup>

</Project>
